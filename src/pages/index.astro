---
import BaseLayout from '../layouts/BaseLayout.astro'
import ArtsContents from '../components/ArtsContents.astro'
import CodeContents from '../components/CodeContents.astro'
---

<BaseLayout title="code|arts">
  <div class="braingrid">
    <h1 class="brand">
      <span class="display arts">Erik&nbsp;</span><span class="display code"
        >Ostrom</span
      >
    </h1>
    <div class="main code display-only">
      <h2 class="main-heading">code</h2>
      <p>
        I'm a freelance web developer, architect, and designer. I love to create
        robust, modern, humane software experiences.
      </p>
      <CodeContents />
    </div>
    <div class="main arts display-only">
      <h2 class="main-heading">arts</h2>
      <p>
        I'm a composer, improviser, singer, player, and theater maker. I love to
        create playful, moving, immersive artistic experiences.
      </p>
      <ArtsContents />
    </div>
    <div class="footer">© 2019, 2024, 2026 Erik Ostrom</div>
  </div>
</BaseLayout>

<style>
  .brand::before,
  .brand::after {
    content: ''; /* don't put brackets around the brand heading */
  }

  .braingrid {
    grid-template-areas:
      'header header header header'
      'code code arts arts'
      'code code arts arts'
      'footer footer footer footer';
  }

  .brand {
    grid-area: header;
    view-transition-name: home-brand;
  }

  .main.code {
    grid-area: code;
    text-align: right;
    padding-left: 25%;

    & h2 {
      view-transition-name: code-side-label;
    }
  }

  .main.arts {
    grid-area: arts;
    padding-right: 25%;

    & h2 {
      view-transition-name: arts-side-label;
    }
  }

  .footer {
    text-align: center;
  }

  @media (max-width: 480px) {
    .braingrid {
      grid-template-areas:
        'header header header header'
        'code code code code'
        'arts arts arts arts'
        'footer footer footer footer';
    }

    .main.code {
      padding-left: 12.5%;
    }

    .main.arts {
      padding-right: 12.5%;
    }
  }
</style>
