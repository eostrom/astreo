---
import BaseLayout from '../layouts/BaseLayout.astro'
import ArtsContents from '../components/ArtsContents.astro'
import CodeContents from '../components/CodeContents.astro'
---

<BaseLayout title="code|arts">
  <div class="braingrid">
    <h1 class="brand">
      <span class="display arts">Erik&nbsp;</span><span class="display code"
        >Ostrom</span
      >
    </h1>
    <main class="home-content">
      <section class="main code display-only">
        <h2 class="main-heading">code</h2>
        <p>
          I'm a freelance web developer, architect, and designer. I love to create
          robust, modern, humane software experiences.
        </p>
        <CodeContents />
      </section>
      <section class="main arts display-only">
        <h2 class="main-heading">arts</h2>
        <p>
          I'm a composer, improviser, singer, player, and theater maker. I love to
          create playful, moving, immersive artistic experiences.
        </p>
        <ArtsContents />
      </section>
    </main>
    <div class="footer">© 2019, 2024, 2026 Erik Ostrom</div>
  </div>
</BaseLayout>

<style>
  .brand::before,
  .brand::after {
    content: ''; /* don't put brackets around the brand heading */
  }

  .braingrid {
    grid-template-areas:
      'header header header header'
      'main main main main'
      'main main main main'
      'footer footer footer footer';
  }

  .brand {
    grid-area: header;
    view-transition-name: home-brand;
  }

  .home-content {
    grid-area: main;
    display: grid;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
  }

  .home-content > .main.code {
    grid-area: 1 / 1 / -1 / span 2;
  }

  .home-content > .main.arts {
    grid-area: 1 / 3 / -1 / span 2;
  }

  .main.code {
    grid-area: code;
    text-align: right;
    padding-left: 25%;

    & h2 {
      view-transition-name: code-side-label;
    }
  }

  .main.arts {
    grid-area: arts;
    padding-right: 25%;

    & h2 {
      view-transition-name: arts-side-label;
    }
  }

  .footer {
    text-align: center;
  }

  @media (max-width: 480px) {
    .braingrid {
      grid-template-areas:
        'header header header header'
        'main main main main'
        'main main main main'
        'footer footer footer footer';
    }

    .main.code {
      padding-left: 12.5%;
    }

    .home-content > .main.code {
      grid-area: 1 / 1 / 2 / -1;
    }

    .main.arts {
      padding-right: 12.5%;
    }

    .home-content > .main.arts {
      grid-area: 2 / 1 / 3 / -1;
    }
  }
</style>
