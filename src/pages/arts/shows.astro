---
import ArtsGrid from '../../layouts/ArtsGrid.astro'
import ShowsList from '../../components/ShowsList.astro'
import {getShowGroups} from '../../utils/shows'

const {comingUp, goneDown} = await getShowGroups()
---

<ArtsGrid title="shows">
  <h1>shows</h1>

  <section>
    <h2>coming up</h2>
    <ShowsList shows={comingUp} emptyMessage="Nothing right now." />
  </section>

  <section>
    <h2>gone down</h2>
    <ShowsList shows={goneDown} />
  </section>
</ArtsGrid>

<style>
  section {
    margin-block-start: 1em;
  }

  section + section {
    margin-block-start: 1.5em;
  }

  section > h2 + p {
    margin-block-start: 0.5em;
  }
</style>
