---
import _ from 'lodash/fp'
import {isBefore, startOfToday} from 'date-fns'
import {tz} from '@date-fns/tz'
import {getCollection} from 'astro:content'
import type {CollectionEntry} from 'astro:content'
import ArtsGrid from '../../layouts/ArtsGrid.astro'
import ShowRows from '../../components/ShowRows.astro'

/*
  Divide shows into "coming up" (today or after, sorted by start date)
  and "gone down" (yesterday or before, sorted by end date).

  Getting this right is tricky, dependent on both the show's time zone
  (which I haven't provided) and the user's (which we can't know when
  building the site). Or we could go by start time, but that's not in
  the data either.

  Also, static site generation means a show that happened after the last
  build but before today will still be listed as "coming up."

  Also ideally we would sort "coming up" not by start date but by next
  occurrence, which is also not available in the current data.

  Anyway, this is good enough for now.
 */

const today = startOfToday({in: tz('utc')})
const allShows = await getCollection('shows')
const isShowOver = (show: CollectionEntry<'shows'>) =>
  // Note: `isAfter` gives the wrong answer for shows that end today
  !isBefore(show.data.lastDate, today)
const [futureShows, pastShows] = _.partition(isShowOver)(allShows)
const goneDown = _.flow(
  _.sortBy((show: CollectionEntry<'shows'>) => show.data.lastDate),
  _.reverse,
)(pastShows)
const comingUp = _.sortBy(
  (show: CollectionEntry<'shows'>) => show.data.firstDate,
)(futureShows)
---

<ArtsGrid title="shows">
  <h1>shows</h1>

  <table class="show-table">
    <thead>
      <tr>
        <td colspan="3"><h2>coming up</h2></td>
      </tr>

      <tr>
        <th><h3>when</h3></th>
        <th><h3>where</h3></th>
        <th><h3>what</h3></th>
      </tr>
    </thead>

    <tbody>
      <ShowRows shows={comingUp} />
    </tbody>

    <thead>
      <tr>
        <td colspan="3"><h2>gone down</h2></td>
      </tr>

      <tr>
        <th><h3>when</h3></th>
        <th><h3>where</h3></th>
        <th><h3>what</h3></th>
      </tr>
    </thead>

    <tbody>
      <ShowRows shows={goneDown} />
    </tbody>
  </table>
</ArtsGrid>

<style>
  .show-table {
    width: 100%;

    :global(h3) {
      padding: 0;
    }

    :global(td),
    :global(th) {
      padding: 0.5em;
      vertical-align: top;
      text-wrap: balance;
      text-wrap: pretty;

      &:not(:first-child) {
        padding-left: 1em;
      }

      &:not(:last-child) {
        padding-right: 1em;
      }
    }
  }

  .show-table :global(td),
  .show-table :global(th) {
    padding: 0.5em 1em;
  }

  .show-table :global(td):first-child,
  .show-table :global(th):first-child {
    padding-left: 0;
  }

  .show-table :global(td):last-child,
  .show-table :global(th):last-child {
    padding-right: 0;
  }

  .show-table :global(h3) {
    padding: 0;
  }
</style>
